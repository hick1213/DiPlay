<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" tools:node="remove" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- iOS may leave all CarPlay audio on the phone when the receiver offers no mic input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" tools:node="remove" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name="com.shilapi.xcertplay.legacy.LegacyApplication"
        android:allowBackup="false"
        android:icon="@drawable/legacy_launcher_icon"
        android:label="${diplayAppLabel}"
        android:theme="@android:style/Theme.Holo.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- The Android Auto / Telecom services require much newer system APIs. -->
        <service android:name="com.shilapi.xcertplay.shared.MyCarAppService" tools:node="remove" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" tools:node="remove" />
        <service android:name="com.shilapi.xcertplay.telecom.PhoneAudioConnectionService"
            tools:node="remove" tools:targetApi="26" />
        <service android:name="com.shilapi.xcertplay.network.CarPlayVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE" />

        <activity
            android:name="com.shilapi.xcertplay.legacy.LegacyCarPlayActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.shilapi.xcertplay.diagnostic.HeadUnitLogActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:label="DiPlay 故障日志">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.shilapi.xcertplay.diagnostic.HeadUnitUploadService"
            android:process=":log_reporter"
            android:exported="false" />
    </application>
</manifest>
